[Unit]
Description=agentden agent - dudu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/agent-team
ExecStart=/home/ubuntu/agent-team/.venv/bin/python /home/ubuntu/agent-team/dudu_bot.py
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
